<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      The grading run (work/GradingWorker) runs as a WorkManager foreground service so
      screen-off does not stop it, and shows "Grading box 2 of 5". POST_NOTIFICATIONS is
      asked for on the grading screen (Android 13+); without it the run still works.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      No CAMERA permission, on purpose: pages are taken with the system camera
      (ACTION_IMAGE_CAPTURE via TakePicture), which needs none. An app that
      declares CAMERA without being granted it gets a SecurityException from
      ACTION_IMAGE_CAPTURE.
    -->

    <application
        android:name=".CapstoneApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Capstone">

        <!-- Required by the LiteRT-LM GPU (OpenCL) vision backend. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Capstone"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Where the system camera writes a page photo: cacheDir/captures only
          (res/xml/capture_paths.xml). ScanViewModel builds the URI.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/capture_paths" />
        </provider>

        <!-- WorkManager's foreground service needs its type declared (Android 14+). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!--
          Microsoft sign-in (MSAL) returns here from the browser tab. The redirect
          URI registered in Entra is msauth://<applicationId>/<url-encoded hash>;
          the path below is the same hash NOT url-encoded. Both come from
          local.properties (webend.signatureHash) via app/build.gradle.kts.
        -->
        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${applicationId}"
                    android:path="/${msalSignatureHash}"
                    android:scheme="msauth" />
            </intent-filter>
        </activity>
    </application>

</manifest>